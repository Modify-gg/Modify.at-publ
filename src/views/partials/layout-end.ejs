    </main>
    <footer class="site-footer">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
    </footer>
    <script>
      (() => {
        const canvas = document.getElementById("interactive-network-background");
        if (!canvas) return;
        const context = canvas.getContext("2d");
        if (!context) return;

        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const pointer = { x: -1000, y: -1000 };
        let points = [];
        let projectiles = [];
        let explosions = [];
        let width = 0;
        let height = 0;
        let lastProjectile = 0;

        function resize() {
          const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = Math.floor(width * ratio);
          canvas.height = Math.floor(height * ratio);
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
          const count = Math.min(72, Math.max(28, Math.floor((width * height) / 19000)));
          points = Array.from({ length: count }, () => ({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.16,
            vy: (Math.random() - 0.5) * 0.16,
            radius: Math.random() * 1.6 + 0.7,
          }));
          projectiles = [];
          explosions = [];
        }

        function createProjectile(now) {
          if (reducedMotion || now - lastProjectile < 1500 || points.length < 2 || Math.random() > 0.018) return;
          const start = points[Math.floor(Math.random() * points.length)];
          const candidates = points.filter((point) => Math.hypot(point.x - start.x, point.y - start.y) > 120);
          if (!candidates.length) return;
          const target = candidates[Math.floor(Math.random() * candidates.length)];
          projectiles.push({ start, target, progress: 0, speed: 0.035 + Math.random() * 0.025 });
          lastProjectile = now;
        }

        function explode(point) {
          explosions.push({
            x: point.x,
            y: point.y,
            life: 1,
            glyph: ["M", "+", "*", "->"][Math.floor(Math.random() * 4)],
            sparks: Array.from({ length: 8 }, (_, index) => ({
              angle: (Math.PI * 2 * index) / 8,
              distance: 0,
            })),
          });
        }

        function draw() {
          context.clearRect(0, 0, width, height);
          const maxDistance = width < 600 ? 108 : 145;
          const now = performance.now();
          createProjectile(now);

          points.forEach((point) => {
            if (!reducedMotion) {
              point.x += point.vx;
              point.y += point.vy;
              if (point.x < -20 || point.x > width + 20) point.vx *= -1;
              if (point.y < -20 || point.y > height + 20) point.vy *= -1;
            }

            const dx = pointer.x - point.x;
            const dy = pointer.y - point.y;
            const distance = Math.hypot(dx, dy);
            if (distance < 170 && distance > 0) {
              point.x -= (dx / distance) * 0.08;
              point.y -= (dy / distance) * 0.08;
            }
          });

          for (let index = 0; index < points.length; index += 1) {
            const point = points[index];
            for (let next = index + 1; next < points.length; next += 1) {
              const other = points[next];
              const distance = Math.hypot(point.x - other.x, point.y - other.y);
              if (distance < maxDistance) {
                const alpha = (1 - distance / maxDistance) * 0.24;
                context.strokeStyle = `rgba(99, 245, 190, ${alpha})`;
                context.lineWidth = 1;
                context.beginPath();
                context.moveTo(point.x, point.y);
                context.lineTo(other.x, other.y);
                context.stroke();
              }
            }
          }

          points.forEach((point) => {
            const distance = Math.hypot(pointer.x - point.x, pointer.y - point.y);
            if (distance < 190) {
              const alpha = (1 - distance / 190) * 0.62;
              context.strokeStyle = `rgba(132, 255, 215, ${alpha})`;
              context.lineWidth = 1.2;
              context.beginPath();
              context.moveTo(pointer.x, pointer.y);
              context.lineTo(point.x, point.y);
              context.stroke();
            }
          });

          points.forEach((point) => {
            const distance = Math.hypot(pointer.x - point.x, pointer.y - point.y);
            const glow = distance < 170 ? 0.9 : 0.55;
            context.fillStyle = `rgba(150, 245, 220, ${glow})`;
            context.beginPath();
            context.arc(point.x, point.y, point.radius, 0, Math.PI * 2);
            context.fill();
          });

          projectiles = projectiles.filter((projectile) => {
            projectile.progress += projectile.speed;
            const start = projectile.start;
            const target = projectile.target;
            const x = start.x + (target.x - start.x) * projectile.progress;
            const y = start.y + (target.y - start.y) * projectile.progress;
            context.strokeStyle = "rgba(255, 255, 255, 0.3)";
            context.lineWidth = 1.5;
            context.beginPath();
            context.moveTo(start.x, start.y);
            context.lineTo(x, y);
            context.stroke();
            context.fillStyle = "rgba(255, 255, 255, 0.95)";
            context.beginPath();
            context.arc(x, y, 2.4, 0, Math.PI * 2);
            context.fill();
            if (projectile.progress >= 1) {
              explode(target);
              return false;
            }
            return true;
          });

          explosions = explosions.filter((burst) => {
            burst.life -= 0.035;
            burst.sparks.forEach((spark) => {
              spark.distance += 2.8;
              const x = burst.x + Math.cos(spark.angle) * spark.distance;
              const y = burst.y + Math.sin(spark.angle) * spark.distance;
              context.fillStyle = `rgba(255, 220, 140, ${burst.life})`;
              context.fillRect(x, y, 2, 2);
            });
            context.strokeStyle = `rgba(255, 220, 140, ${burst.life * 0.8})`;
            context.lineWidth = 1.5;
            context.beginPath();
            context.arc(burst.x, burst.y, (1 - burst.life) * 28, 0, Math.PI * 2);
            context.stroke();
            context.fillStyle = `rgba(255, 255, 255, ${burst.life})`;
            context.font = "700 12px Segoe UI, sans-serif";
            context.fillText(burst.glyph, burst.x + 7, burst.y - 7);
            return burst.life > 0;
          });

          if (!reducedMotion) window.requestAnimationFrame(draw);
        }

        window.addEventListener("resize", resize, { passive: true });
        window.addEventListener("pointermove", (event) => {
          pointer.x = event.clientX;
          pointer.y = event.clientY;
        }, { passive: true });
        window.addEventListener("pointerleave", () => {
          pointer.x = -1000;
          pointer.y = -1000;
        }, { passive: true });
        resize();
        draw();
      })();
    </script>
    <script>
      document.querySelectorAll(".mod-card-link[data-href]").forEach((card) => {
        card.addEventListener("click", (event) => {
          if (event.target.closest("a, button, form, input, textarea, select")) return;
          window.location.href = card.dataset.href;
        });
        card.addEventListener("keydown", (event) => {
          if ((event.key === "Enter" || event.key === " ") && !event.target.closest("a, button, form, input, textarea, select")) {
            event.preventDefault();
            window.location.href = card.dataset.href;
          }
        });
      });
    </script>
  </body>
</html>

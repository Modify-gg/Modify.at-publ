<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title ? `${title} | modify.at` : "modify.at" %></title>
    <link rel="stylesheet" href="/styles/main.css?v=<%= assetVersion %>" />
    <% if (!currentUser) { %>
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7721626603982200" crossorigin="anonymous"></script>
    <% } %>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">modify<span>.at</span></a>
      <nav class="site-nav">
        <a href="/mods">Mods</a>
        <a href="/help">Help</a>
        <% if (currentUser) { %>
          <a href="/upload">Upload</a>
          <a href="/dashboard">Dashboard</a>
          <% if (currentUser.role === "admin") { %>
            <a href="/admin">Admin</a>
          <% } %>
          <form action="/logout" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="ghost-button" type="submit">Sign out</button>
          </form>
        <% } else { %>
          <a href="/login">Sign in</a>
          <a class="primary-link" href="/register">Create account</a>
        <% } %>
      </nav>
    </header>
    <% if (notice) { %>
      <div class="notice"><%= notice %></div>
    <% } %>
    <main>

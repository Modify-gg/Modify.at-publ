<%- include("partials/layout-start", { title: "Dashboard" }) %>

<section class="page-head">
  <div>
    <p class="eyebrow">creator dashboard</p>
    <h1><%= currentUser.username %>, your releases are here.</h1>
  </div>
  <a class="primary-link" href="/upload">Upload a mod</a>
  <a class="secondary-link" href="/profile">Edit profile</a>
</section>

<section class="dashboard-columns">
  <div class="admin-panel">
    <div class="section-heading"><h2>Favorites</h2><span><%= favoriteMods.length %></span></div>
    <% if (favoriteMods.length) { %>
      <% favoriteMods.forEach((mod) => { %><a class="side-link" href="/mods/<%= mod.slug %>"><%= mod.title %> <span class="side-link-meta">(<%= mod.downloadCount %> downloads)</span></a><% }) %>
    <% } else { %><p class="helper-copy">Save mods here so you can find them again.</p><% } %>
  </div>
  <div class="admin-panel">
    <div class="section-heading"><h2>Notifications</h2><form action="/notifications/read" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="secondary-link" type="submit">Mark read</button></form></div>
    <% if (notifications.length) { %>
      <% notifications.forEach((entry) => { %><a class="side-link <%= entry.read ? '' : 'unread-notification' %>" href="/mods/<%= entry.modSlug %>"><strong><%= entry.title %></strong><br /><span class="side-link-meta"><%= entry.message %></span></a><% }) %>
    <% } else { %><p class="helper-copy">No notifications yet.</p><% } %>
  </div>
</section>

<section class="admin-panel analytics-panel">
  <div class="section-heading"><h2>Download analytics</h2><span><%= creatorDownloadEvents.length %> tracked downloads</span></div>
  <p class="helper-copy">Downloads are recorded per release so you can see how your work is being discovered.</p>
</section>

<section class="stats-row">
  <div class="stat-panel">
    <span>Published mods</span>
    <strong><%= userMods.length %></strong>
  </div>
  <div class="stat-panel">
    <span>Total downloads</span>
    <strong><%= userMods.reduce((sum, mod) => sum + mod.downloadCount, 0) %></strong>
  </div>
  <div class="stat-panel">
    <span>Most recent release</span>
    <strong><%= userMods[0] ? userMods[0].title : "None yet" %></strong>
  </div>
</section>

<section class="list-stack">
  <% if (userMods.length) { %>
    <% userMods.forEach((mod) => { %>
      <a class="list-row" href="/mods/<%= mod.slug %>">
        <div class="list-icon">
          <% if (mod.iconUrl) { %>
            <img src="<%= mod.iconUrl %>" alt="" />
          <% } else { %>
            <span><%= mod.title.slice(0, 1).toUpperCase() %></span>
          <% } %>
        </div>
        <div>
          <strong><%= mod.title %></strong>
          <p><%= mod.summary %></p>
        </div>
        <div class="list-row-meta">
          <span class="status-badge <%= mod.isSafe ? 'safe-badge' : 'warn-badge' %>"><%= mod.isSafe ? "Safe" : "Unverified" %></span>
          <span><%= mod.game %></span>
          <span><%= mod.downloadCount %> downloads</span>
        </div>
      </a>
    <% }) %>
  <% } else { %>
    <article class="empty-state">
      <h3>No releases yet</h3>
      <p>Your dashboard is ready for its first upload.</p>
    </article>
  <% } %>
</section>

<%- include("partials/layout-end") %>

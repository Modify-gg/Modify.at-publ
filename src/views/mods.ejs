<%- include("partials/layout-start", { title: "Mods" }) %>

<section class="page-head">
  <div>
    <p class="eyebrow">browse the catalog</p>
    <h1>Find your next install.</h1>
  </div>
  <form class="search-bar" action="/mods" method="get">
    <input type="text" name="q" placeholder="Search titles, games, creators" value="<%= query %>" />
    <select name="game">
      <option value="">All games</option>
      <% allGames.forEach((gameOption) => { %>
        <option value="<%= gameOption.slug %>" <%= game === gameOption.slug ? "selected" : "" %>><%= gameOption.name %></option>
      <% }) %>
    </select>
    <select name="status">
      <option value="" <%= !status ? "selected" : "" %>>All statuses</option>
      <option value="safe" <%= status === "safe" ? "selected" : "" %>>Safe only</option>
    </select>
    <select name="sort">
      <option value="newest" <%= sort === "newest" ? "selected" : "" %>>Newest</option>
      <option value="popular" <%= sort === "popular" ? "selected" : "" %>>Most downloaded</option>
      <option value="oldest" <%= sort === "oldest" ? "selected" : "" %>>Oldest</option>
    </select>
    <button type="submit">Search</button>
  </form>
</section>

<section class="section-block" id="game-directory">
  <div class="section-heading">
    <div>
      <p class="eyebrow">choose a game</p>
      <h2>Browse by game</h2>
    </div>
  </div>
  <div class="game-grid">
    <% gameDirectory.forEach((gameEntry) => { %>
      <a class="game-card" href="/mods?game=<%= encodeURIComponent(gameEntry.slug) %>">
        <div class="game-card-art">
          <% if (gameEntry.iconUrl) { %>
            <img src="<%= gameEntry.iconUrl %>" alt="" />
          <% } else { %>
            <span><%= gameEntry.name.slice(0, 1).toUpperCase() %></span>
          <% } %>
        </div>
        <div class="game-card-copy">
          <div class="game-card-head">
            <h3><%= gameEntry.name %></h3>
            <span aria-hidden="true">&#8594;</span>
          </div>
          <p><%= gameEntry.modCount %> mod<%= gameEntry.modCount === 1 ? "" : "s" %> available</p>
        </div>
      </a>
    <% }) %>
  </div>
</section>

<section class="mod-grid">
  <% if (mods.length) { %>
    <% mods.forEach((mod) => { %>
      <article class="mod-card">
        <a class="mod-icon" href="/mods/<%= mod.slug %>" aria-label="<%= mod.title %>">
          <% if (mod.iconUrl) { %>
            <img src="<%= mod.iconUrl %>" alt="<%= mod.title %> icon" />
          <% } else { %>
            <span><%= mod.title.slice(0, 1).toUpperCase() %></span>
          <% } %>
        </a>
        <div class="mod-meta-line">
          <span><%= mod.game %></span>
          <span><%= mod.category %></span>
        </div>
        <div class="badge-row">
          <span class="status-badge <%= mod.isSafe ? 'safe-badge' : 'warn-badge' %>"><%= mod.isSafe ? "Safe" : "Unverified" %></span>
        </div>
        <h3><a href="/mods/<%= mod.slug %>"><%= mod.title %></a></h3>
        <p><%= mod.summary %></p>
        <div class="mod-footer">
          <span>by <a href="/creators/<%= encodeURIComponent(mod.authorName) %>"><%= mod.authorName %></a></span>
          <span><%= mod.downloadCount %> downloads</span>
        </div>
      </article>
    <% }) %>
  <% } else { %>
    <article class="empty-state">
      <h3>No matches yet</h3>
      <p>Try a broader search or upload the exact thing you wanted to find.</p>
    </article>
  <% } %>
</section>

<%- include("partials/layout-end") %>

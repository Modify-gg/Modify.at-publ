<%- include("partials/layout-start", { title: "Create account" }) %>

<section class="auth-shell">
  <form class="auth-card recaptcha-form" action="/register" method="post" data-recaptcha-action="register">
    <p class="eyebrow">creator access</p>
    <h1>Create your account</h1>
    <label>
      <span>Username</span>
      <input type="text" name="username" required />
    </label>
    <label>
      <span>Email</span>
      <input type="email" name="email" required />
    </label>
    <label>
      <span>Password</span>
      <input type="password" name="password" minlength="8" required />
    </label>
    <input type="hidden" name="g-recaptcha-response" />
    <button class="primary-button" type="submit">Start publishing</button>
  </form>
</section>

<% if (recaptchaEnabled) { %>
  <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptchaSiteKey %>" async defer></script>
  <script>
    const recaptchaSiteKey = "<%= recaptchaSiteKey %>";
    document.querySelectorAll(".recaptcha-form").forEach((form) => {
      form.addEventListener("submit", (event) => {
        if (form.dataset.recaptchaReady === "true") {
          return;
        }

        event.preventDefault();
        const submitButton = form.querySelector("button[type='submit']");
        if (submitButton) {
          submitButton.disabled = true;
        }

        grecaptcha.ready(() => {
          grecaptcha.execute(recaptchaSiteKey, { action: form.dataset.recaptchaAction || "register" })
            .then((token) => {
              form.querySelector("input[name='g-recaptcha-response']").value = token;
              form.dataset.recaptchaReady = "true";
              form.submit();
            })
            .catch(() => {
              if (submitButton) {
                submitButton.disabled = false;
              }
            });
        });
      });
    });
  </script>
<% } %>

<%- include("partials/layout-end") %>

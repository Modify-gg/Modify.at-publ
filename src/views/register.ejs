<%- include("partials/layout-start", { title: "Create account" }) %>

<section class="auth-shell">
  <form class="auth-card" action="/register" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <p class="eyebrow">creator access</p>
    <h1>Create your account</h1>
    <label>
      <span>Username</span>
      <input type="text" name="username" required />
    </label>
    <label>
      <span>Email</span>
      <input type="email" name="email" required />
    </label>
    <label>
      <span>Password</span>
      <input type="password" name="password" minlength="8" required />
    </label>
    <% if (recaptchaEnabled) { %>
      <div class="g-recaptcha auth-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
    <% } %>
    <button class="primary-button" type="submit">Start publishing</button>
  </form>
</section>

<% if (recaptchaEnabled) { %>
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
<% } %>

<%- include("partials/layout-end") %>

<%- include("partials/layout-start", { title: "Create account" }) %>

<section class="auth-shell">
  <form class="auth-card recaptcha-form" action="/register" method="post">
    <p class="eyebrow">creator access</p>
    <h1>Create your account</h1>
    <label>
      <span>Username</span>
      <input type="text" name="username" required />
    </label>
    <label>
      <span>Email</span>
      <input type="email" name="email" required />
    </label>
    <label>
      <span>Password</span>
      <input type="password" name="password" minlength="8" required />
    </label>
    <input type="hidden" name="g-recaptcha-response" />
    <% if (recaptchaEnabled) { %>
      <div class="recaptcha-target" data-sitekey="<%= recaptchaSiteKey %>"></div>
    <% } %>
    <button class="primary-button" type="submit">Start publishing</button>
  </form>
</section>

<% if (recaptchaEnabled) { %>
  <script src="https://www.google.com/recaptcha/api.js?render=explicit" async defer></script>
  <script>
    function enableInvisibleRecaptcha() {
      document.querySelectorAll(".recaptcha-form").forEach((form) => {
        const target = form.querySelector(".recaptcha-target");
        if (!target || target.dataset.widgetId) {
          return;
        }

        target.dataset.widgetId = grecaptcha.render(target, {
          sitekey: target.dataset.sitekey,
          size: "invisible",
          callback: (token) => {
            form.querySelector("input[name='g-recaptcha-response']").value = token;
            form.dataset.recaptchaReady = "true";
            form.submit();
          },
          "error-callback": () => {
            const submitButton = form.querySelector("button[type='submit']");
            if (submitButton) {
              submitButton.disabled = false;
            }
          },
        });
      });
    }

    window.addEventListener("load", enableInvisibleRecaptcha);

    document.querySelectorAll(".recaptcha-form").forEach((form) => {
      form.addEventListener("submit", (event) => {
        if (form.dataset.recaptchaReady === "true") {
          return;
        }

        event.preventDefault();
        const submitButton = form.querySelector("button[type='submit']");
        if (submitButton) {
          submitButton.disabled = true;
        }

        if (typeof grecaptcha === "undefined") {
          if (submitButton) {
            submitButton.disabled = false;
          }
          return;
        }

        enableInvisibleRecaptcha();
        const target = form.querySelector(".recaptcha-target");
        grecaptcha.execute(Number(target.dataset.widgetId));
      });
    });
  </script>
<% } %>

<%- include("partials/layout-end") %>

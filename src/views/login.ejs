<%- include("partials/layout-start", { title: "Sign in" }) %>

<section class="auth-shell">
  <form class="auth-card" action="/login" method="post">
    <p class="eyebrow">welcome back</p>
    <h1>Sign in</h1>
    <label>
      <span>Email</span>
      <input type="email" name="email" required />
    </label>
    <label>
      <span>Password</span>
      <input type="password" name="password" required />
    </label>
    <button class="primary-button" type="submit">Enter modify.at</button>
    <% if (googleAuthEnabled) { %>
      <a class="google-button" href="/auth/google">Continue with Google</a>
    <% } else { %>
      <p class="helper-copy">Google sign-in needs Google app keys in Vercel.</p>
    <% } %>
  </form>
</section>

<%- include("partials/layout-end") %>

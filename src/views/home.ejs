<%- include("partials/layout-start", { title: "Home" }) %>

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">a multi-game mod hub</p>
    <h1>Find mods for your game.</h1>
    <p class="hero-text">
      Browse community-made mods for the games you play, or publish your own release with a creator page, version history, and clear safety status.
    </p>
    <div class="hero-actions">
      <a class="primary-link" href="#game-directory">Browse games</a>
      <a class="secondary-link" href="/upload">Publish your mod</a>
      <a class="secondary-link" href="/help">Learn more</a>
    </div>
  </div>
  <div class="hero-panel">
    <div>
      <span>Active mods</span>
      <strong><%= totalMods %></strong>
    </div>
    <div>
      <span>Creators</span>
      <strong><%= totalCreators %></strong>
    </div>
    <div>
      <span>Built for</span>
      <strong>More than one game</strong>
    </div>
  </div>
</section>

<section class="section-block" id="game-directory">
  <div class="section-heading">
    <div>
      <p class="eyebrow">choose your starting point</p>
      <h2>Browse by game</h2>
    </div>
    <a href="/mods">View all mods</a>
  </div>
  <div class="game-grid">
    <% if (gameDirectory.length) { %>
      <% gameDirectory.forEach((game) => { %>
        <a class="game-card" href="/mods?game=<%= encodeURIComponent(game.slug) %>">
          <div class="game-card-art">
            <% if (game.coverUrl) { %>
              <img src="<%= game.coverUrl %>" alt="" />
            <% } else { %>
              <span><%= game.name.slice(0, 1).toUpperCase() %></span>
            <% } %>
          </div>
          <div class="game-card-copy">
            <div class="game-card-head">
              <h3><%= game.name %></h3>
              <span aria-hidden="true">&#8594;</span>
            </div>
            <p><%= game.modCount %> mod<%= game.modCount === 1 ? "" : "s" %> available</p>
            <% if (game.latestTitle) { %><small>Latest: <%= game.latestTitle %></small><% } else { %><small>Be the first creator here</small><% } %>
          </div>
        </a>
      <% }) %>
    <% } else { %>
      <article class="empty-state"><h3>No games yet</h3><p>The catalog is ready for its first game.</p></article>
    <% } %>
  </div>
</section>

<section class="section-block creator-callout">
  <div>
    <p class="eyebrow">for creators</p>
    <h2>A straightforward home for your releases.</h2>
    <p class="hero-text">Publish mods for games that do not have a strong central mod hub yet. Every release gets a creator profile, download count, version history, gallery, and moderation status.</p>
  </div>
  <a class="primary-link" href="/register">Create a creator account</a>
</section>

<section class="section-block">
  <div class="section-heading">
    <h2>Featured drops</h2>
    <a href="/mods">See all mods</a>
  </div>
  <div class="mod-grid">
    <% if (featuredMods.length) { %>
      <% featuredMods.forEach((mod) => { %>
        <article class="mod-card mod-card-link" data-href="/mods/<%= mod.slug %>" tabindex="0" role="link">
          <a class="mod-icon" href="/mods/<%= mod.slug %>" aria-label="<%= mod.title %>">
            <% if (mod.iconUrl) { %>
              <img src="<%= mod.iconUrl %>" alt="<%= mod.title %> icon" />
            <% } else { %>
              <span><%= mod.title.slice(0, 1).toUpperCase() %></span>
            <% } %>
          </a>
          <div class="mod-meta-line">
            <span><%= mod.game %></span>
            <span><%= mod.category %></span>
          </div>
          <div class="badge-row">
            <span class="status-badge <%= mod.isSafe ? 'safe-badge' : 'warn-badge' %>"><%= mod.isSafe ? "Safe" : "Unverified" %></span>
          </div>
          <h3><a href="/mods/<%= mod.slug %>"><%= mod.title %></a></h3>
          <p><%= mod.summary %></p>
          <div class="mod-footer">
            <span>by <%= mod.authorName %></span>
            <span><%= mod.downloadCount %> downloads</span>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <article class="empty-state">
        <h3>No mods yet</h3>
        <p>The first upload gets to define the tone around here.</p>
      </article>
    <% } %>
  </div>
</section>

<section class="section-block">
  <div class="section-heading">
    <h2>Latest uploads</h2>
  </div>
  <div class="list-stack">
    <% if (newestMods.length) { %>
      <% newestMods.forEach((mod) => { %>
        <a class="list-row" href="/mods/<%= mod.slug %>">
          <div class="list-icon">
            <% if (mod.iconUrl) { %>
              <img src="<%= mod.iconUrl %>" alt="" />
            <% } else { %>
              <span><%= mod.title.slice(0, 1).toUpperCase() %></span>
            <% } %>
          </div>
          <div>
            <strong><%= mod.title %></strong>
            <p><%= mod.summary %></p>
          </div>
          <div class="list-row-meta">
            <span class="status-badge <%= mod.isSafe ? 'safe-badge' : 'warn-badge' %>"><%= mod.isSafe ? "Safe" : "Unverified" %></span>
            <span><%= mod.game %></span>
            <span>v<%= mod.version %></span>
          </div>
        </a>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <h3>Your catalog is empty</h3>
        <p>Create an account and upload the first release.</p>
      </div>
    <% } %>
  </div>
</section>

<%- include("partials/layout-end") %>

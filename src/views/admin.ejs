<%- include("partials/layout-start", { title: "Admin" }) %>

<section class="page-head">
  <div>
    <p class="eyebrow">admin controls</p>
    <h1>Moderation, catalog, and users.</h1>
  </div>
</section>

<section class="admin-grid">
  <div class="admin-column">
    <div class="admin-panel">
      <h2>Open reports</h2>
      <% if (reports.length) { %>
        <div class="list-stack">
          <% reports.forEach((report) => { %>
            <div class="admin-item">
              <div class="admin-item-head"><strong><a href="/mods/<%= report.modSlug %>"><%= report.modTitle %></a></strong><span><%= report.reason %></span></div>
              <p>Reported by <%= report.reporterName %><% if (report.details) { %>: <%= report.details %><% } %></p>
              <div class="action-row">
                <form action="/admin/reports/<%= report.id %>/resolve" method="post"><button class="primary-button" type="submit">Resolve</button></form>
                <form action="/admin/reports/<%= report.id %>/dismiss" method="post"><button class="secondary-link" type="submit">Dismiss</button></form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %><p>No open reports.</p><% } %>
    </div>

    <div class="admin-panel">
      <h2>Add game</h2>
      <form class="inline-form" action="/admin/games" method="post">
        <input type="text" name="name" placeholder="Game name" required />
        <button class="primary-button" type="submit">Add game</button>
      </form>
    </div>

    <div class="admin-panel">
      <h2>Games and sub-categories</h2>
      <div class="list-stack">
        <% games.forEach((game) => { %>
          <div class="admin-item">
            <div class="admin-item-head">
              <strong><%= game.name %></strong>
              <span><%= game.categories.length %> categories</span>
            </div>
            <div class="badge-row">
              <% game.categories.forEach((category) => { %>
                <span class="status-badge plain-badge"><%= category %></span>
              <% }) %>
            </div>
            <form class="inline-form" action="/admin/games/<%= game.slug %>/categories" method="post">
              <input type="text" name="categoryName" placeholder="Add sub-category" required />
              <button class="secondary-link" type="submit">Add</button>
            </form>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="admin-panel">
      <h2>Recent activity</h2>
      <div class="list-stack">
        <% activity.slice(0, 12).forEach((entry) => { %>
          <div class="admin-item"><div class="admin-item-head"><strong><%= entry.action.replaceAll("_", " ") %></strong><span><%= new Date(entry.createdAt).toLocaleString() %></span></div><p><%= entry.actorName %><% if (entry.details) { %> / <%= entry.details %><% } %></p></div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="admin-column">
    <div class="admin-panel">
      <h2>Mods</h2>
      <form class="search-bar admin-search" action="/admin" method="get">
        <input type="text" name="modQuery" placeholder="Search mods, games, authors" value="<%= modQuery %>" />
        <select name="modStatus">
          <option value="" <%= !modStatus ? "selected" : "" %>>All statuses</option>
          <option value="unverified" <%= modStatus === "unverified" ? "selected" : "" %>>Needs review</option>
          <option value="safe" <%= modStatus === "safe" ? "selected" : "" %>>Safe</option>
        </select>
        <button type="submit">Filter</button>
      </form>
      <div class="list-stack">
        <% if (mods.length) { %>
          <% mods.forEach((mod) => { %>
            <div class="admin-item">
              <div class="admin-mod-row">
                <div class="list-icon">
                  <% if (mod.iconUrl) { %>
                    <img src="<%= mod.iconUrl %>" alt="" />
                  <% } else { %>
                    <span><%= mod.title.slice(0, 1).toUpperCase() %></span>
                  <% } %>
                </div>
                <div>
                  <div class="admin-item-head">
                    <strong><a href="/mods/<%= mod.slug %>"><%= mod.title %></a></strong>
                    <span class="status-badge <%= mod.isSafe ? 'safe-badge' : 'warn-badge' %>"><%= mod.isSafe ? "Safe" : "Unverified" %></span>
                  </div>
                  <p><%= mod.game %> / <%= mod.category %> by <%= mod.authorName %></p>
                </div>
              </div>
              <div class="action-row">
                <% if (mod.isSafe) { %>
                  <form action="/admin/mods/<%= mod.id %>/unverify" method="post">
                    <button class="secondary-link" type="submit">Mark unverified</button>
                  </form>
                <% } else { %>
                  <form action="/admin/mods/<%= mod.id %>/verify" method="post">
                    <button class="primary-button" type="submit">Mark safe</button>
                  </form>
                <% } %>
                <form action="/admin/mods/<%= mod.id %>/delete" method="post">
                  <button class="danger-button" type="submit">Delete mod</button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state">
            <h3>No mods found</h3>
            <p>Try clearing the admin search or switching status filters.</p>
          </div>
        <% } %>
      </div>
    </div>

    <div class="admin-panel">
      <h2>Users</h2>
      <div class="list-stack">
        <% users.forEach((user) => { %>
          <div class="admin-item">
            <div class="admin-item-head">
              <strong><%= user.username %></strong>
              <span class="status-badge <%= user.role === 'admin' ? 'safe-badge' : 'plain-badge' %>"><%= user.role %></span>
            </div>
            <p><%= user.email %></p>
            <% if (user.id !== currentUser.id) { %>
              <form action="/admin/users/<%= user.id %>/delete" method="post">
                <button class="danger-button" type="submit">Delete user</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<%- include("partials/layout-end") %>

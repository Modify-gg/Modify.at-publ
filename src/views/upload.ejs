<%- include("partials/layout-start", { title: "Upload mod" }) %>

<section class="auth-shell upload-shell">
  <form class="auth-card upload-card" action="/upload" method="post" enctype="multipart/form-data">
    <p class="eyebrow">publish a release</p>
    <h1>Upload a mod</h1>
    <label>
      <span>Title</span>
      <input type="text" name="title" required />
    </label>
    <label>
      <span>Game</span>
      <select name="gameSlug" id="gameSlug" required>
        <% allGames.forEach((game) => { %>
          <option value="<%= game.slug %>"><%= game.name %></option>
        <% }) %>
      </select>
    </label>
    <label>
      <span>Sub-category</span>
      <select name="category" id="category" required></select>
    </label>
    <label>
      <span>Version</span>
      <input type="text" name="version" placeholder="1.0.0" required />
    </label>
    <label>
      <span>Summary</span>
      <input type="text" name="summary" maxlength="140" required />
    </label>
    <label>
      <span>Description</span>
      <textarea name="description" rows="6" required></textarea>
    </label>
    <label>
      <span>Install instructions</span>
      <textarea name="installInstructions" rows="4" placeholder="Example: Put the file in your Mods folder, then restart the game."></textarea>
    </label>
    <label>
      <span>Release notes</span>
      <textarea name="releaseNotes" rows="4" placeholder="What changed in this version?"></textarea>
    </label>
    <label>
      <span>Mod icon</span>
      <input type="file" name="iconFile" accept="image/png,image/jpeg,image/webp,image/gif" />
      <small class="helper-copy">Square images work best. 245x245 is perfect.</small>
    </label>
    <label>
      <span>Gallery pictures</span>
      <input type="file" name="galleryFiles" accept="image/png,image/jpeg,image/webp,image/gif" multiple />
      <small class="helper-copy">Add up to 6 pictures that show what the mod contains.</small>
    </label>
    <label>
      <span>Mod file</span>
      <input type="file" name="modFile" required />
    </label>
    <p class="helper-copy" id="uploadStatus"></p>
    <% if (hostedWithoutSupabase) { %>
      <p class="helper-copy">Uploads are waiting for Supabase environment variables on Vercel.</p>
    <% } %>
    <button class="primary-button" type="submit" <%= hostedWithoutSupabase ? "disabled" : "" %>>Publish release</button>
  </form>
</section>

<script>
  const gameCatalog = <%- JSON.stringify(allGames) %>;
  const gameSelect = document.getElementById("gameSlug");
  const categorySelect = document.getElementById("category");

  function renderCategories() {
    const currentGame = gameCatalog.find((entry) => entry.slug === gameSelect.value);
    const categories = currentGame && currentGame.categories.length ? currentGame.categories : ["General"];
    categorySelect.innerHTML = categories
      .map((category) => `<option value="${category}">${category}</option>`)
      .join("");
  }

  gameSelect.addEventListener("change", renderCategories);
  renderCategories();
</script>

<% if (supabaseBrowserConfig) { %>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    const supabaseConfig = <%- JSON.stringify(supabaseBrowserConfig) %>;
    const uploadForm = document.querySelector(".upload-card");
    const uploadStatus = document.getElementById("uploadStatus");
    const publishButton = uploadForm.querySelector("button[type='submit']");
    const supabaseClient = supabase.createClient(supabaseConfig.url, supabaseConfig.anonKey);

    uploadForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(uploadForm);
      const file = formData.get("modFile");
      const iconFile = formData.get("iconFile");
      const galleryFiles = formData.getAll("galleryFiles").filter((entry) => entry && entry.name);

      if (!file || !file.name) {
        uploadStatus.textContent = "Choose a file first.";
        return;
      }

      if (!file.size) {
        uploadStatus.textContent = "That file looks empty. Download it to the device first, then choose it again.";
        return;
      }

      if (galleryFiles.length > 6) {
        uploadStatus.textContent = "Choose up to 6 gallery pictures.";
        return;
      }

      publishButton.disabled = true;
      uploadStatus.textContent = "Preparing upload...";

      try {
        const signResponse = await fetch("/upload/sign", {
          method: "POST",
          credentials: "same-origin",
          headers: {
            "accept": "application/json",
            "content-type": "application/json",
          },
          body: JSON.stringify({
            originalFileName: file.name,
            fileSize: file.size,
            contentType: file.type || "application/octet-stream",
            iconOriginalFileName: iconFile && iconFile.name ? iconFile.name : "",
            galleryOriginalFileNames: galleryFiles.map((galleryFile) => galleryFile.name),
          }),
        });

        const signContentType = signResponse.headers.get("content-type") || "";
        if (!signResponse.ok) {
          const errorBody = signContentType.includes("application/json")
            ? await signResponse.json()
            : null;
          throw new Error(errorBody && errorBody.error ? errorBody.error : "Could not prepare the upload.");
        }

        if (!signContentType.includes("application/json")) {
          throw new Error("Sign in again, then try uploading.");
        }

        const signedUpload = await signResponse.json();
        uploadStatus.textContent = "Uploading mod file...";

        const { error: uploadError } = await supabaseClient.storage
          .from(supabaseConfig.bucket)
          .uploadToSignedUrl(signedUpload.filePath, signedUpload.token, file, {
            contentType: file.type || "application/octet-stream",
          });

        if (uploadError) {
          throw uploadError;
        }

        if (signedUpload.icon && iconFile && iconFile.name) {
          uploadStatus.textContent = "Uploading mod icon...";
          const { error: iconUploadError } = await supabaseClient.storage
            .from(supabaseConfig.bucket)
            .uploadToSignedUrl(signedUpload.icon.filePath, signedUpload.icon.token, iconFile, {
              contentType: iconFile.type || "application/octet-stream",
            });

          if (iconUploadError) {
            throw iconUploadError;
          }
        }

        for (let index = 0; index < signedUpload.gallery.length; index += 1) {
          uploadStatus.textContent = `Uploading gallery picture ${index + 1} of ${signedUpload.gallery.length}...`;
          const galleryUpload = signedUpload.gallery[index];
          const galleryFile = galleryFiles[index];
          const { error: galleryUploadError } = await supabaseClient.storage
            .from(supabaseConfig.bucket)
            .uploadToSignedUrl(galleryUpload.filePath, galleryUpload.token, galleryFile, {
              contentType: galleryFile.type || "application/octet-stream",
            });

          if (galleryUploadError) {
            throw galleryUploadError;
          }
        }

        uploadStatus.textContent = "Publishing mod...";
        const completeBody = new URLSearchParams();
        for (const [key, value] of formData.entries()) {
          if (!["modFile", "iconFile", "galleryFiles"].includes(key)) {
            completeBody.set(key, value);
          }
        }
        completeBody.set("uploadToken", signedUpload.uploadToken);

        const completeResponse = await fetch("/upload/complete", {
          method: "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/x-www-form-urlencoded" },
          body: completeBody,
        });

        if (!completeResponse.ok) {
          throw new Error("Could not publish the mod.");
        }

        window.location.href = completeResponse.url;
      } catch (error) {
        uploadStatus.textContent = error.message || "Upload failed. Try again.";
        publishButton.disabled = false;
      }
    });
  </script>
<% } %>

<%- include("partials/layout-end") %>
